0000: 04000a13   addi x20, x0, 64       # base de memoria
0004: 00400093   addi x1, x0, 4
0008: 00400113   addi x2, x0, 4
000c: 00000193   addi x3, x0, 0         # acumulador de control
0010: 00208663   beq  x1, x2, t1        # par v1 : beq TOMADO en via 1 ...
0014: 06418193   addi x3, x3, 100       # par v2 : ... la via 2 (mas joven) se ANULA
0018: 0c818193   addi x3, x3, 200       # anulada (camino incorrecto)
001c: 00118193   t1:     addi x3, x3, 1         # par v1 : x3 = 1
0020: 00008263   beq  x1, x0, n1        # par v2 : beq NO tomado en via 2
0024: 00008263   n1:     beq  x1, x0, n2        # par v1 : beq NO tomado en via 1 ...
0028: 00218193   n2:     addi x3, x3, 2         # par v2 : ... la via 2 se ejecuta -> x3 = 3
002c: 00418193   addi x3, x3, 4         # par v1 : la via 1 (mas antigua) se CONSERVA -> x3 = 7
0030: 00208663   beq  x1, x2, t2        # par v2 : beq TOMADO en via 2
0034: 19018193   addi x3, x3, 400       # anulada
0038: 1f418193   addi x3, x3, 500       # anulada
003c: 00008263   t2:     beq  x1, x0, n3        # par v1 : dos saltos en el mismo par -> conflicto de control,
0040: 00208463   n3:     beq  x1, x2, t3        # par v2 :   solo se emite la via 1; el segundo se reagrupa (TOMADO)
0044: 25818193   addi x3, x3, 600       # anulada
0048: 00c002ef   t3:     jal  x5, t4            # par v1 : jal en via 1 -> la via 2 no se emite; x5 = PC+4 = 0x4C
004c: 2bc18193   addi x3, x3, 700       # anulada
0050: 32018193   addi x3, x3, 800       # anulada
0054: 00818193   t4:     addi x3, x3, 8         # par v1 : la via 1 se CONSERVA -> x3 = 15
0058: 00c0036f   jal  x6, t5            # par v2 : jal en via 2 ; x6 = PC+4 = 0x5C
005c: 38418193   addi x3, x3, 900       # anulada
0060: 3e818193   addi x3, x3, 1000      # anulada
0064: 00300393   t5:     addi x7, x0, 3         # contador del bucle
0068: 00000413   addi x8, x0, 0         # suma
006c: 00038a63   loop:   beq  x7, x0, end       # par v1 : sale del bucle cuando x7 = 0
0070: 00740433   add  x8, x8, x7        # par v2 : suma += contador
0074: fff38393   addi x7, x7, -1        # par v1
0078: ff5ff06f   jal  x0, loop          # par v2 : salto hacia atras desde la via 2
007c: 3e840413   addi x8, x8, 1000      # nunca se ejecuta
0080: 003a2023   end:    sw   x3, 0(x20)        # M[64] = 15
0084: 005a2223   sw   x5, 4(x20)        # M[68] = 0x4C (76)
0088: 006a2423   sw   x6, 8(x20)        # M[72] = 0x5C (92)
008c: 008a2623   sw   x8, 12(x20)       # M[76] = 6 (3 + 2 + 1)
0090: 007a2823   sw   x7, 16(x20)       # M[80] = 0
0094: 00000063   done:   beq  x0, x0, done
