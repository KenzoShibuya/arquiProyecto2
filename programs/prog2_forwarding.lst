0000: 04000a13   addi x20, x0, 64       # base de memoria
0004: 00000793   addi x15, x0, 0        # x15 = 0 (debe seguir en 0 al final)
0008: 00a00093   addi x1, x0, 10        # x1 = 10
000c: 00300113   addi x2, x0, 3         # x2 = 3
0010: 002081b3   add  x3, x1, x2        # B desde MEM (x2), A desde WB (x1)    -> 13
0014: 40118233   sub  x4, x3, x1        # A desde MEM (x3)                      -> 3
0018: 003162b3   or   x5, x2, x3        # B desde WB (x3)                       -> 15
001c: 00327333   and  x6, x4, x3        # A desde WB (x4)                       -> 1
0020: 00530393   addi x7, x6, 5         # A desde MEM (x6)                      -> 6
0024: 00100413   addi x8, x0, 1         # x8 = 1 (valor viejo, queda en WB)
0028: 00200413   addi x8, x0, 2         # x8 = 2 (valor nuevo, queda en MEM)
002c: 008404b3   add  x9, x8, x8        # A y B desde MEM: gana el mas reciente -> 4
0030: 00700013   addi x0, x0, 7         # intenta escribir x0 (RegWrite=1, Rd=0)
0034: 00200533   add  x10, x0, x2       # x0 NO se reenvia                      -> 3
0038: 04d00593   addi x11, x0, 77       # x11 = 77
003c: 00ba2023   sw   x11, 0(x20)       # dato del sw desde MEM (ForwardBE=10)  -> M[64] = 77
0040: 00748633   add  x12, x9, x7       # 4 + 6                                 -> 10
0044: 00000013   nop
0048: 00ca2223   sw   x12, 4(x20)       # dato del sw desde WB (ForwardBE=01)   -> M[68] = 10
004c: 00500693   addi x13, x0, 5
0050: 00500713   addi x14, x0, 5
0054: 00e68463   beq  x13, x14, ok      # A desde WB, B desde MEM -> TOMADO
0058: fff00793   addi x15, x0, -1       # anulada por el salto (x15 queda en 0)
005c: 003a2423   ok:     sw   x3, 8(x20)        # M[72]  = 13
0060: 004a2623   sw   x4, 12(x20)       # M[76]  = 3
0064: 005a2823   sw   x5, 16(x20)       # M[80]  = 15
0068: 006a2a23   sw   x6, 20(x20)       # M[84]  = 1
