0000: 04000a13   addi x20, x0, 64       # base de memoria
0004: 00400093   addi x1, x0, 4
0008: 00400113   addi x2, x0, 4
000c: 00000193   addi x3, x0, 0         # acumulador
0010: 00208663   beq  x1, x2, t1        # TOMADO -> se anulan las 2 siguientes
0014: 06418193   addi x3, x3, 100       # anulada
0018: 0c818193   addi x3, x3, 200       # anulada
001c: 00118193   t1:     addi x3, x3, 1         # x3 = 1
0020: 00008463   beq  x1, x0, nt        # NO tomado (4 != 0): no hay flush
0024: 00218193   addi x3, x3, 2         # se ejecuta -> x3 = 3
0028: 00c002ef   nt:     jal  x5, fwd           # TOMADO, x5 = PC+4 = 44 (0x2C)
002c: 1f418193   addi x3, x3, 500       # anulada
0030: 25818193   addi x3, x3, 600       # anulada
0034: 00300313   fwd:    addi x6, x0, 3         # contador
0038: 00000393   addi x7, x0, 0         # suma
003c: 00030a63   loop:   beq  x6, x0, end       # sale cuando x6 = 0
0040: 006383b3   add  x7, x7, x6        # suma += contador
0044: fff30313   addi x6, x6, -1        # contador--
0048: ff5ff06f   jal  x0, loop          # salto hacia atras (flush en cada vuelta)
004c: 3e838393   addi x7, x7, 1000      # nunca debe ejecutarse
0050: 003a2023   end:    sw   x3, 0(x20)        # M[64] = 3
0054: 005a2223   sw   x5, 4(x20)        # M[68] = 44
0058: 007a2423   sw   x7, 8(x20)        # M[72] = 6  (3 + 2 + 1)
005c: 006a2623   sw   x6, 12(x20)       # M[76] = 0
0060: 00000063   done:   beq  x0, x0, done
